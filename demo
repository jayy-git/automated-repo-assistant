"""
repository_analyzer.py  (Person A)

Public function:
    analyze_repository(repo_url) -> dict

Always returns the SAME keys. If something fails, "error" contains a
readable message and the other keys hold safe empty values.

Safety: only metadata and file paths are read. Nothing from the scanned
repository is downloaded, run, or installed.

Rate limits: unauthenticated GitHub API = 60 requests/hour per IP.
Each scan uses 2 requests; repeat scans of the same repo within
CACHE_TTL_SECONDS use none. Set the GITHUB_TOKEN environment variable to
raise the limit. Never commit a token to git.
"""

import copy
import logging
import os
import re
import threading
import time
from collections import Counter
from datetime import datetime
from urllib.parse import quote

import requests
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------
API_BASE = "https://api.github.com"
TIMEOUT_SECONDS = 10
CACHE_TTL_SECONDS = 600
CACHE_MAX_ENTRIES = 128

URL_PATTERN = re.compile(
    r"^(?:https?://)?(?:www\.)?github\.com/"
    r"(?P<owner>[A-Za-z0-9-]+)/"
    r"(?P<repo>[A-Za-z0-9._-]+?)"
    r"(?:\.git)?/?(?:[/?#].*)?$"
)

EXTENSION_LANGUAGES = {
    ".py": "Python", ".js": "JavaScript", ".jsx": "JavaScript",
    ".ts": "TypeScript", ".tsx": "TypeScript", ".java": "Java",
    ".c": "C", ".h": "C", ".cpp": "C++", ".hpp": "C++", ".cs": "C#",
    ".go": "Go", ".rs": "Rust", ".rb": "Ruby", ".php": "PHP",
    ".swift": "Swift", ".kt": "Kotlin", ".scala": "Scala",
    ".r": "R", ".m": "Objective-C", ".sh": "Shell", ".html": "HTML",
    ".css": "CSS", ".scss": "CSS", ".ipynb": "Jupyter Notebook",
    ".dart": "Dart", ".lua": "Lua", ".sql": "SQL",
}

DOC_FOLDERS = {"", "docs", ".github"}

README_NAMES = {"README"}
LICENSE_NAMES = {"LICENSE", "LICENCE", "COPYING", "LICENSE-MIT", "LICENSE-APACHE"}
CONTRIBUTING_NAMES = {"CONTRIBUTING"}

REQUIREMENTS_NAMES = {
    "requirements.txt", "pyproject.toml", "setup.py", "setup.cfg",
    "Pipfile", "environment.yml", "package.json", "pom.xml",
    "build.gradle", "Cargo.toml", "go.mod", "Gemfile", "composer.json",
}

# Folders holding third-party or generated code. Ignored for language counts
# and dependency files so a committed node_modules/ does not distort results.
IGNORED_FOLDERS = {
    "node_modules", "vendor", "third_party", "site-packages",
    "dist", "build", "__pycache__", ".git",
}


def _build_session():
    """One reusable session that retries transient GitHub server errors."""
    session = requests.Session()
    try:
        retry = Retry(
            total=2, backoff_factor=0.5,
            status_forcelist=(500, 502, 503, 504),
            allowed_methods=("GET",),
        )
    except TypeError:  # very old urllib3
        retry = Retry(total=2, backoff_factor=0.5, status_forcelist=(500, 502, 503, 504))
    adapter = HTTPAdapter(max_retries=retry)
    session.mount("https://", adapter)
    return session


_session = _build_session()

_cache = {}
_cache_lock = threading.Lock()


class AnalyzerError(Exception):
    """An expected problem with a user-friendly message."""


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def empty_result(repo_url=""):
    """The agreed data shape, filled with safe default values."""
    return {
        "repo_url": repo_url if isinstance(repo_url, str) else "",
        "repo_name": "",
        "description": "",
        "default_branch": "",
        "files": [],
        "languages": {},
        "readme_exists": False,
        "license_exists": False,
        "contributing_exists": False,
        "requirements_files": [],
        "error": None,
    }


def parse_github_url(repo_url):
    """Return (owner, repo) or raise AnalyzerError if the URL is invalid."""
    if not isinstance(repo_url, str) or not repo_url.strip():
        raise AnalyzerError("Please enter a GitHub repository URL.")

    match = URL_PATTERN.match(repo_url.strip())
    if not match:
        raise AnalyzerError(
            "That doesn't look like a GitHub repository URL. "
            "Use the format https://github.com/owner/repository"
        )

    owner, repo = match.group("owner"), match.group("repo")
    if owner.startswith("-") or owner.endswith("-") or len(owner) > 39:
        raise AnalyzerError("The owner name is not valid.")
    if repo in (".", "..") or len(repo) > 100:
        raise AnalyzerError("The repository name is not valid.")
    return owner, repo


def _headers():
    """Request headers. The token is read on every call, so it can be set late."""
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "RepoGuide-Analyzer",
    }
    token = os.getenv("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def _reset_time(response):
    """Readable time when the rate limit resets, or 'later'."""
    try:
        return datetime.fromtimestamp(
            int(response.headers.get("X-RateLimit-Reset"))
        ).strftime("%H:%M")
    except (TypeError, ValueError, OverflowError, OSError):
        return "later"


def github_get(path):
    """
    GET a GitHub API path and return parsed JSON.
    Returns None for HTTP 409 (empty repository).
    Raises AnalyzerError with a readable message for every other problem.
    """
    try:
        response = _session.get(
            f"{API_BASE}{path}", headers=_headers(), timeout=TIMEOUT_SECONDS
        )
    except requests.Timeout:
        raise AnalyzerError("GitHub took too long to respond. Please try again.")
    except requests.ConnectionError:
        raise AnalyzerError("Could not connect to GitHub. Check your internet connection.")
    except requests.RequestException:
        logger.exception("Network error while contacting GitHub")
        raise AnalyzerError("A network error occurred while contacting GitHub.")

    status = response.status_code

    if status == 200:
        try:
            return response.json()
        except ValueError:
            raise AnalyzerError("GitHub returned data we could not read.")

    if status == 404:
        raise AnalyzerError("Repository not found. It may not exist, or it may be private.")

    if status == 409:  # GitHub uses 409 for "repository is empty"
        return None

    if status == 429 or (status == 403 and response.headers.get("X-RateLimit-Remaining") == "0"):
        raise AnalyzerError(
            f"GitHub API rate limit reached. Please try again after {_reset_time(response)}, "
            "or set the GITHUB_TOKEN variable."
        )

    if status == 403:
        raise AnalyzerError("GitHub refused access to this repository.")

    raise AnalyzerError(f"GitHub API error (HTTP {status}). Please try again later.")


def _is_vendored(path):
    """True if the file sits inside a third-party or generated folder."""
    return any(part in IGNORED_FOLDERS for part in path.split("/")[:-1])


def has_doc(files, accepted_names):
    """True if README / LICENSE / CONTRIBUTING exists in the root, docs/ or .github/."""
    for path in files:
        folder, _, filename = path.rpartition("/")
        stem = filename.split(".")[0].upper()
        if folder in DOC_FOLDERS and stem in accepted_names:
            return True
    return False


def find_requirements_files(files):
    """Dependency files anywhere in the repo (outside vendored folders)."""
    found = []
    for path in files:
        if _is_vendored(path):
            continue
        name = path.rsplit("/", 1)[-1]
        if name in REQUIREMENTS_NAMES or (
            name.startswith("requirements") and name.endswith(".txt")
        ):
            found.append(path)
    return found


def count_languages(files):
    """Count files per language using extensions (outside vendored folders)."""
    counts = Counter()
    for path in files:
        if _is_vendored(path):
            continue
        dot = path.rfind(".")
        if dot > path.rfind("/") + 1:  # ignore dotfiles such as ".gitignore"
            language = EXTENSION_LANGUAGES.get(path[dot:].lower())
            if language:
                counts[language] += 1
    return dict(counts.most_common())


def _cache_get(key):
    with _cache_lock:
        entry = _cache.get(key)
        if entry and time.monotonic() - entry[0] < CACHE_TTL_SECONDS:
            return copy.deepcopy(entry[1])
        _cache.pop(key, None)
    return None


def _cache_put(key, result):
    with _cache_lock:
        if len(_cache) >= CACHE_MAX_ENTRIES:
            oldest = min(_cache, key=lambda k: _cache[k][0])
            _cache.pop(oldest, None)
        _cache[key] = (time.monotonic(), copy.deepcopy(result))


def clear_cache():
    """Forget all cached scans (useful for tests or a manual refresh)."""
    with _cache_lock:
        _cache.clear()


# ---------------------------------------------------------------------------
# Main function (the team contract)
# ---------------------------------------------------------------------------
def analyze_repository(repo_url):
    """Analyze a public GitHub repo. Never raises; check result["error"]."""
    result = empty_result(repo_url)

    try:
        owner, repo = parse_github_url(repo_url)

        key = f"{owner}/{repo}".lower()
        cached = _cache_get(key)
        if cached is not None:
            return cached

        # API call 1: repository metadata
        meta = github_get(f"/repos/{owner}/{repo}") or {}
        branch = meta.get("default_branch") or "main"

        result["repo_url"] = meta.get("html_url") or f"https://github.com/{owner}/{repo}"
        result["repo_name"] = meta.get("name") or repo
        result["description"] = meta.get("description") or ""
        result["default_branch"] = branch

        # API call 2: every file path in one recursive request
        tree = github_get(
            f"/repos/{owner}/{repo}/git/trees/{quote(branch, safe='/')}?recursive=1"
        ) or {}
        if tree.get("truncated"):
            logger.warning("File list truncated for %s/%s (very large repo).", owner, repo)

        files = [
            item["path"]
            for item in tree.get("tree", [])
            if item.get("type") == "blob" and item.get("path")
        ]

        # Everything below is computed locally (no extra API calls)
        result["files"] = files
        result["languages"] = count_languages(files)
        result["readme_exists"] = has_doc(files, README_NAMES)
        result["license_exists"] = has_doc(files, LICENSE_NAMES)
        result["contributing_exists"] = has_doc(files, CONTRIBUTING_NAMES)
        result["requirements_files"] = find_requirements_files(files)

        _cache_put(key, result)  # only successful scans are cached

    except AnalyzerError as exc:
        result["error"] = str(exc)
    except Exception:
        logger.exception("Unexpected error while analyzing %s", repo_url)
        result["error"] = "Something unexpected went wrong. Please try again."

    return result


