# Person A: Repository Analyzer (`repository_analyzer.py`)

Your job is to turn a GitHub URL into one predictable Python dictionary. B and C only read that dictionary, so they never need to know how the GitHub API works.

---

## 1. The Code

### `repository_analyzer.py`

```python
"""
repository_analyzer.py  -  Person A (Repository Analyzer)

Main function:
    analyze_repository(repo_url) -> dict

It always returns the SAME dictionary shape. If something goes wrong,
the "error" key holds a readable message instead of a crash.
Only public metadata and file paths are read. No repository code is run.
"""

import logging
import os
import re
from urllib.parse import quote, urlparse

import requests

logger = logging.getLogger(__name__)

GITHUB_API = "https://api.github.com"
TIMEOUT_SECONDS = 10

# GitHub owner/org names: letters, digits, hyphens (max 39 characters)
OWNER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,38}$")
# Repository names: letters, digits, '.', '_', '-'
REPO_RE = re.compile(r"^[A-Za-z0-9._-]{1,100}$")

README_PREFIXES = ("readme",)
LICENSE_PREFIXES = ("license", "licence", "copying")
CONTRIBUTING_PREFIXES = ("contributing",)
DEPENDENCY_NAMES = {"pipfile", "pyproject.toml", "setup.py", "package.json"}


class RepoAnalyzerError(Exception):
    """An expected problem. Its message is safe to show to users."""


# ---------------------------------------------------------------------------
# PUBLIC FUNCTION
# ---------------------------------------------------------------------------

def analyze_repository(repo_url):
    """Return normalized repository facts for a public GitHub repo.

    On success: result["error"] is None.
    On failure: result["error"] is a readable message; other keys keep safe defaults.
    """
    result = _empty_result(repo_url)

    try:
        owner, repo = parse_github_url(repo_url)           # 1. validate (no network yet)
        result["repo_url"] = f"https://github.com/{owner}/{repo}"

        with requests.Session() as session:                 # 2. one connection, reused
            session.headers.update(_build_headers())

            # Request 1: repository metadata
            info = _get_json(session, f"/repos/{owner}/{repo}")
            branch = info.get("default_branch") or "main"
            result.update({
                "repo_name": info.get("name") or repo,
                "description": info.get("description") or "",
                "default_branch": branch,
            })

            # Request 2: every file path in one call (recursive tree)
            tree = _get_json(
                session,
                f"/repos/{owner}/{repo}/git/trees/{quote(branch, safe='/')}?recursive=1",
            )
            if tree is None:  # GitHub answers 409 for an empty repository
                raise RepoAnalyzerError("This repository is empty (it has no files yet).")
            if tree.get("truncated"):
                logger.warning("File list truncated for %s/%s (very large repo).", owner, repo)

            # Request 3: languages, e.g. {"Python": 12345}
            languages = _get_json(session, f"/repos/{owner}/{repo}/languages") or {}

        # 3. Turn the raw tree into a simple list of file paths (files only, no folders)
        files = [item["path"] for item in tree.get("tree", []) if item.get("type") == "blob"]

        result.update({
            "files": files,
            "languages": languages,
            "readme_exists": _has_document(files, README_PREFIXES),
            "license_exists": bool(info.get("license")) or _has_document(files, LICENSE_PREFIXES),
            "contributing_exists": _has_document(files, CONTRIBUTING_PREFIXES,
                                                 check_github_folder=True),
            "requirements_files": [f for f in files if _is_dependency_file(f)],
        })

    except RepoAnalyzerError as err:                        # expected problems
        result["error"] = str(err)
    except Exception:                                       # safety net: never crash the app
        logger.exception("Unexpected error while analyzing %s", repo_url)
        result["error"] = "Something unexpected went wrong. Please try again."

    return result


# ---------------------------------------------------------------------------
# HELPERS
# ---------------------------------------------------------------------------

def parse_github_url(repo_url):
    """Turn a GitHub URL into (owner, repo). Raise RepoAnalyzerError if invalid."""
    text = (repo_url or "").strip()
    if not text:
        raise RepoAnalyzerError("Please enter a GitHub repository URL.")

    if "://" not in text:                       # allow "github.com/owner/repo"
        text = "https://" + text

    parsed = urlparse(text)
    host = parsed.netloc.lower().removeprefix("www.")
    if host != "github.com":
        raise RepoAnalyzerError("The link must be a github.com repository URL.")

    parts = [p for p in parsed.path.split("/") if p]    # ignore empty pieces
    if len(parts) < 2:
        raise RepoAnalyzerError("The URL must look like https://github.com/owner/repo.")

    owner, repo = parts[0], parts[1]
    if repo.endswith(".git"):
        repo = repo[:-4]

    if not OWNER_RE.match(owner) or not REPO_RE.match(repo) or repo in (".", ".."):
        raise RepoAnalyzerError("The owner or repository name contains invalid characters.")

    return owner, repo


def _get_json(session, path):
    """GET one GitHub API path and return parsed JSON.

    Returns None for HTTP 409 (empty repository).
    Raises RepoAnalyzerError with a readable message for every other failure.
    """
    try:
        response = session.get(GITHUB_API + path, timeout=TIMEOUT_SECONDS)
    except requests.Timeout:
        raise RepoAnalyzerError("GitHub took too long to respond. Please try again.")
    except requests.ConnectionError:
        raise RepoAnalyzerError("Could not reach GitHub. Check your internet connection.")
    except requests.RequestException:
        raise RepoAnalyzerError("A network error occurred while contacting GitHub.")

    status = response.status_code
    if status == 200:
        try:
            return response.json()
        except ValueError:
            raise RepoAnalyzerError("GitHub sent a response that could not be read.")
    if status == 409:
        return None
    if status == 404:
        raise RepoAnalyzerError(
            "Repository not found. Check the URL. Private repositories cannot be scanned."
        )
    if status == 429 or (status == 403 and response.headers.get("X-RateLimit-Remaining") == "0"):
        raise RepoAnalyzerError(
            "GitHub rate limit reached. Wait about an hour, or set the GITHUB_TOKEN variable."
        )
    if status == 403:
        raise RepoAnalyzerError("GitHub refused access to this repository.")
    raise RepoAnalyzerError(f"GitHub returned an unexpected status code ({status}).")


def _has_document(files, prefixes, check_github_folder=False):
    """True if a top-level file (or one in .github/) has a name starting with a prefix."""
    for path in files:
        parts = path.lower().split("/")
        at_root = len(parts) == 1
        in_github_folder = check_github_folder and len(parts) == 2 and parts[0] == ".github"
        if (at_root or in_github_folder) and parts[-1].startswith(prefixes):
            return True
    return False


def _is_dependency_file(path):
    """True for files that list project dependencies, e.g. requirements.txt."""
    name = path.lower().split("/")[-1]
    is_requirements = name.startswith("requirements") and name.endswith(".txt")
    return is_requirements or name in DEPENDENCY_NAMES


def _build_headers():
    """Headers for GitHub. A token is optional and read from an environment variable."""
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "RepoGuide-Student-Project",
    }
    token = os.getenv("GITHUB_TOKEN")           # never hard-code a token in the code
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def _empty_result(repo_url):
    """The default shape. Every key exists even when something fails."""
    return {
        "repo_url": repo_url or "",
        "repo_name": "",
        "description": "",
        "default_branch": "",
        "files": [],
        "languages": {},
        "readme_exists": False,
        "license_exists": False,
        "contributing_exists": False,
        "requirements_files": [],
        "error": None,
    }


# ---------------------------------------------------------------------------
# Quick manual test:  python repository_analyzer.py
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    import json

    logging.basicConfig(level=logging.INFO)
    for url in [
        "https://github.com/psf/requests",   # real public repo
        "https://github.com/does-not/exist",  # 404 example
        "not a url",                          # invalid example
    ]:
        print(f"\n--- {url}")
        print(json.dumps(analyze_repository(url), indent=2))
```

### `test_repository_analyzer.py` (offline tests, no internet needed)

```python
import pytest
from repository_analyzer import (
    RepoAnalyzerError,
    analyze_repository,
    _has_document,
    _is_dependency_file,
    parse_github_url,
)


def test_parses_normal_url():
    assert parse_github_url("https://github.com/psf/requests") == ("psf", "requests")


def test_accepts_git_suffix_trailing_slash_and_missing_scheme():
    assert parse_github_url("github.com/psf/requests.git/") == ("psf", "requests")


def test_rejects_other_hosts():
    with pytest.raises(RepoAnalyzerError):
        parse_github_url("https://gitlab.com/psf/requests")


def test_rejects_missing_repo_name():
    with pytest.raises(RepoAnalyzerError):
        parse_github_url("https://github.com/psf")


def test_rejects_empty_input():
    with pytest.raises(RepoAnalyzerError):
        parse_github_url("   ")


def test_bad_url_returns_error_and_full_shape():
    result = analyze_repository("not a url")          # fails before any network call
    assert result["error"]
    assert set(result) == {
        "repo_url", "repo_name", "description", "default_branch", "files",
        "languages", "readme_exists", "license_exists", "contributing_exists",
        "requirements_files", "error",
    }


def test_document_detection():
    files = ["README.md", "src/main.py", ".github/CONTRIBUTING.md"]
    assert _has_document(files, ("readme",))
    assert _has_document(files, ("contributing",), check_github_folder=True)
    assert not _has_document(files, ("contributing",))          # not checked in .github


def test_dependency_detection():
    assert _is_dependency_file("requirements.txt")
    assert _is_dependency_file("backend/requirements-dev.txt")
    assert not _is_dependency_file("src/main.py")
